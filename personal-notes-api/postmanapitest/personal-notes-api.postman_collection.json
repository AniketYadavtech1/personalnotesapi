    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": {"raw":"{{baseUrl}}/api/auth/signup","host":["{{baseUrl}}"],"path":["api","auth","signup"]},
        "body": {"mode":"raw","raw":"{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"yourPassword\"\n}"}
      },
      "event": [{
        "listen":"test",
        "script":{"type":"text/javascript","exec":[
          "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
          "pm.test('Success true', function () { pm.expect(pm.response.json().success).to.be.true; });",
          "pm.test('Token present', function () { pm.expect(pm.response.json()).to.have.property('token'); });",
          "pm.environment.set('token', pm.response.json().token);"
        ]}
      }]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": {"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]},
        "body": {"mode":"raw","raw":"{\n  \"email\": \"john@example.com\",\n  \"password\": \"yourPassword\"\n}"}
      },
      "event": [{
        "listen":"test",
        "script":{"type":"text/javascript","exec":[
          "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
          "pm.test('Login success', function () { pm.expect(pm.response.json().success).to.be.true; });",
          "pm.test('Token returned', function () { pm.expect(pm.response.json()).to.have.property('token'); });",
          "pm.environment.set('token', pm.response.json().token);"
        ]}
      }]
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [{"key":"Authorization","value":"Bearer {{token}}"}],
        "url": {"raw":"{{baseUrl}}/api/auth/profile","host":["{{baseUrl}}"],"path":["api","auth","profile"]}
      },
      "event": [{
        "listen":"test",
        "script":{"type":"text/javascript","exec":[
          "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
          "pm.test('Profile success', function () { pm.expect(pm.response.json().success).to.be.true; });",
          "pm.test('User object present', function () { pm.expect(pm.response.json()).to.have.property('user'); });"
        ]}
      }]
